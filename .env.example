# --- Bright Data (web scraping/fetching) ---
BRIGHTDATA_API_KEY=
BRIGHTDATA_COLLECTOR_ID=
BRIGHTDATA_DATASET_ID=

# --- LLM provider (server-side only, used for research synthesis) ---
# This must be named LLM_API_KEY, NOT API_KEY. It is a different setting
# from the WebMind app WEBMIND_API_KEY below. Mixing these up is a common bug:
# setting API_KEY instead of LLM_API_KEY will (a) leave the LLM unauthenticated
# and (b) unexpectedly turn ON WebMind app-level auth, causing 401s in the UI.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# --- WebMind app-level API auth (frontend <-> backend), OPTIONAL ---
# Leave empty for local development (no auth enforced).
# If set, every request to /api/v1/* must send:
#   X-API-Key: <this value>
# or
#   Authorization: Bearer <this value>
# The current bundled frontend does NOT send this header, so only set this
# for local dev if you also update the frontend to send it.
WEBMIND_API_KEY=

RATE_LIMIT_PER_MINUTE=30
